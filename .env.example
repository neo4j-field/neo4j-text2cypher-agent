NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_URI="bolt://localhost:7687"
NEO4J_DATABASE="neo4j"

# OpenAI Configuration
OPENAI_API_KEY="sk-..."

# Azure OpenAI Configuration (alternative to OpenAI)
AZURE_OPENAI_API_KEY="your-azure-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"
# Required for semantic similarity: deployment name for embeddings model
# Find this in Azure Portal > Your OpenAI Resource > Deployments
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT="your-embeddings-deployment-name"

