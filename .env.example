NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="password"
NEO4J_URI="bolt://localhost:7687"
NEO4J_DATABASE="neo4j"

# OpenAI Configuration
OPENAI_API_KEY="sk-..."

# Azure OpenAI Configuration (alternative to OpenAI)
AZURE_OPENAI_API_KEY="your-azure-api-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-02-15-preview"

# Azure OpenAI Embeddings Configuration (for semantic similarity)
# Required: deployment name for embeddings model
# Find this in:
# - Azure Portal > Your OpenAI Resource > Deployments
# - Azure AI Foundry portal > My assets > Models + endpoints
# - Or directly at: https://oai.azure.com/resource/deployments
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT="your-embeddings-deployment-name"

# Optional: Use separate Azure resource for embeddings
# Uncomment these if your embeddings are in a different Azure OpenAI resource
# AZURE_OPENAI_EMBEDDINGS_ENDPOINT="https://your-embeddings-resource.openai.azure.com/"
# AZURE_OPENAI_EMBEDDINGS_API_KEY="your-embeddings-api-key"
# AZURE_OPENAI_EMBEDDINGS_API_VERSION="2024-02-01"

